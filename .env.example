# Which service reads the tickets first: anthropic | openrouter
VISION_PROVIDER=openrouter

# The stronger second reader, used ONLY on tickets the first one left with an
# empty cell in one of the fields below — so the cost tracks the failure rate,
# not the volume. Set VISION_ESCALATE_MODEL to "none" to turn it off.
VISION_ESCALATE_MODEL=claude-opus-5-5
VISION_ESCALATE_FIELDS=unit_price,surgeon,hospital,surgery_date

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Only read when VISION_PROVIDER=openrouter. The model must accept IMAGES —
# and so must the fallback, or every ticket fails on the backup.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=qwen/qwen3-vl-235b-a22b-instruct
OPENROUTER_FALLBACK_MODEL=qwen/qwen3-vl-32b-instruct
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>     # server-side only, never ship to a client
RETENTION_DAYS=14                            # mirrors app_settings; informational
SUM_TOLERANCE=0.01                           # grand-total reconciliation tolerance
VISION_CONF_THRESHOLD=medium                 # min model confidence to write a value
PRICE_SANITY_MAX=7500                        # line price at/above this flags as a likely misread

# PHI. When false (the default) the app never reads patient data at all. When
# true, the patient sticker is cropped from the pre-mask image at ingest and sent
# to the vision API to read ONLY the patient's two initials for the "Inits"
# column; the stored photo is still fully redacted and the name is never kept.
# Requires a HIPAA BAA on the Anthropic account and the db/10 migration.
EXTRACT_PATIENT_INITIALS=false

# Optional: when true, the app runs without Supabase/Anthropic and uses a local
# on-disk store + deterministic-only extraction. Useful for local UI development
# and for running the bundled fixtures offline. Set to false in production.
OFFLINE_MODE=false

# Local data directory used only when OFFLINE_MODE=true (mimics Storage buckets).
LOCAL_DATA_DIR=.localdata

# --- Daily status email (weekday 5pm "did anyone run this today?") ---------
# Deliberately the SAME variable names as the Maxx dashboard, because this sends
# through the SAME Hostinger relay and the SAME mailbox. Read the live values
# off the dashboard container rather than hunting for them — they are runtime
# environment there and committed nowhere:
#
#   docker compose exec maxxdash-dashboard \
#     printenv EMAIL_FROM SMTP_HOST SMTP_USER SMTP_PASSWORD
#
# EMAIL_FROM must be the SAME address as SMTP_USER. Hostinger authenticates the
# envelope sender, so a mismatch is refused outright rather than delivered from
# the wrong name — that is the failure "Send a test now" exists to surface.
#
# Leave these blank and the app runs exactly as before: the Notifications card
# says it is not connected yet and names the missing value, and nothing is sent.
# Recipients are NOT set here — they live in the app (Reference data ->
# Daily status email) so the list can change without a deploy.
EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# When the status email goes out. The timezone is a real zone name, not a fixed
# offset, so 5pm stays 5pm across the DST changeover.
NOTIFY_TIMEZONE=America/New_York
NOTIFY_HOUR=17
